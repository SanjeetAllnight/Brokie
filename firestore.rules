rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user can only read and write their own document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow the same for any subcollection under the user document
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
